-- [AI生成] v17 -> v18：新增常用配料组两表 B5。
-- 新表不存在于旧库，CREATE TABLE 安全；全新安装由 Schema.create 自带这两表、不走本迁移。
CREATE TABLE ingredient_group (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'user',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE ingredient_group_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    group_id INTEGER NOT NULL REFERENCES ingredient_group(id) ON DELETE CASCADE,
    ingredient_name TEXT NOT NULL,
    is_main INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_ingredient_group_item_order ON ingredient_group_item(group_id, sort_order, id);
