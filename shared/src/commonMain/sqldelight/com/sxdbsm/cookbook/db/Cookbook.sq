-- ============================================================
-- Cookbook 数据库 schema (v1)
-- 设计文档参考: .codex/docs/feature/数据库设计方案.md
-- ============================================================

-- ========== 字典/基础表 ==========

CREATE TABLE cooking_method (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    source TEXT NOT NULL DEFAULT 'preset',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE crowd_type (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'preset',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE measurement_unit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    source TEXT NOT NULL DEFAULT 'preset',
    status INTEGER NOT NULL DEFAULT 1
);

-- ========== 食材体系 ==========

CREATE TABLE ingredient (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    alias TEXT NOT NULL DEFAULT '',
    pinyin TEXT NOT NULL DEFAULT '',
    image_path TEXT NOT NULL DEFAULT '',
    thumbnail_path TEXT NOT NULL DEFAULT '',
    emoji TEXT NOT NULL DEFAULT '🥗',
    default_unit_id INTEGER REFERENCES measurement_unit(id),
    source TEXT NOT NULL DEFAULT 'preset',
    created_at INTEGER NOT NULL,
    last_referenced_at INTEGER NOT NULL DEFAULT 0,
    status INTEGER NOT NULL DEFAULT 1,
    reason TEXT NOT NULL DEFAULT '' -- [AI生成] 失效原因：status=0 时说明为何失效（后台下架说明 / 用户删除）。
);

CREATE INDEX idx_ingredient_pinyin ON ingredient(pinyin);

CREATE TABLE food_category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    dimension TEXT NOT NULL DEFAULT 'general',
    parent_id INTEGER REFERENCES food_category(id),
    crowd_type_id INTEGER REFERENCES crowd_type(id),
    sort_order INTEGER NOT NULL DEFAULT 0,
    icon TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'preset',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_food_category_parent ON food_category(parent_id);

CREATE TABLE ingredient_category (
    ingredient_id INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    category_id INTEGER NOT NULL REFERENCES food_category(id) ON DELETE CASCADE,
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (ingredient_id, category_id)
);

-- [AI生成] 食材详情扩展表：承载做法、处理、注意事项、保存和健康说明。
CREATE TABLE ingredient_detail (
    ingredient_id INTEGER NOT NULL PRIMARY KEY REFERENCES ingredient(id) ON DELETE CASCADE,
    common_methods TEXT NOT NULL DEFAULT '',
    prep_tips TEXT NOT NULL DEFAULT '',
    eating_notes TEXT NOT NULL DEFAULT '',
    storage_tips TEXT NOT NULL DEFAULT '',
    health_note TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT 0,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE crowd_ingredient (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    crowd_id INTEGER NOT NULL REFERENCES crowd_type(id) ON DELETE CASCADE,
    ingredient_id INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    advice_level TEXT NOT NULL,
    reason TEXT NOT NULL DEFAULT '',
    daily_limit REAL,
    source TEXT NOT NULL DEFAULT 'preset',
    status INTEGER NOT NULL DEFAULT 1
);

CREATE UNIQUE INDEX uq_crowd_ingredient ON crowd_ingredient(crowd_id, ingredient_id);

-- [AI生成] 通用调养规则：后续承接病种、人群、身体状态等食材建议，不再局限 crowd_type。
CREATE TABLE ingredient_care_rule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ingredient_id INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    category_id INTEGER NOT NULL REFERENCES food_category(id) ON DELETE CASCADE,
    advice_level TEXT NOT NULL,
    reason TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'preset',
    status INTEGER NOT NULL DEFAULT 1
);

CREATE UNIQUE INDEX uq_ingredient_care_rule ON ingredient_care_rule(ingredient_id, category_id);
CREATE INDEX idx_ingredient_care_rule_category ON ingredient_care_rule(category_id, advice_level);

-- ========== 菜品体系 ==========

CREATE TABLE dish (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    cooking_method_id INTEGER REFERENCES cooking_method(id),
    preference INTEGER NOT NULL DEFAULT 0,
    special_note TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL DEFAULT '',
    image_path TEXT NOT NULL DEFAULT '',
    thumbnail_path TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT 'user',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_dish_preference ON dish(preference DESC);
CREATE INDEX idx_dish_updated_at ON dish(updated_at DESC);
CREATE INDEX idx_dish_name ON dish(name COLLATE NOCASE);

-- [AI生成] 菜品可关联多个烹饪方式；保留 dish.cooking_method_id 作为旧数据兼容和首个方式缓存。
CREATE TABLE dish_cooking_method_rel (
    dish_id INTEGER NOT NULL REFERENCES dish(id) ON DELETE CASCADE,
    cooking_method_id INTEGER NOT NULL REFERENCES cooking_method(id) ON DELETE CASCADE,
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (dish_id, cooking_method_id)
);

CREATE TABLE dish_tag (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    source TEXT NOT NULL DEFAULT 'user',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE dish_tag_rel (
    dish_id INTEGER NOT NULL REFERENCES dish(id) ON DELETE CASCADE,
    tag_id INTEGER NOT NULL REFERENCES dish_tag(id) ON DELETE CASCADE,
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (dish_id, tag_id)
);

CREATE TABLE dish_ingredient (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    dish_id INTEGER NOT NULL REFERENCES dish(id) ON DELETE CASCADE,
    ingredient_id INTEGER NOT NULL REFERENCES ingredient(id),
    quantity REAL,
    unit_id INTEGER REFERENCES measurement_unit(id),
    is_main INTEGER NOT NULL DEFAULT 1,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE UNIQUE INDEX uq_dish_ingredient ON dish_ingredient(dish_id, ingredient_id);

-- [AI生成] 菜品操作步骤：每一步保存文字和多图路径，图片路径沿用 `|` 分隔编码。
CREATE TABLE dish_step (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    dish_id INTEGER NOT NULL REFERENCES dish(id) ON DELETE CASCADE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    text TEXT NOT NULL DEFAULT '',
    image_path TEXT NOT NULL DEFAULT '',
    thumbnail_path TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_dish_step_dish_order ON dish_step(dish_id, sort_order, id);

CREATE TABLE dish_crowd (
    dish_id INTEGER NOT NULL REFERENCES dish(id) ON DELETE CASCADE,
    crowd_id INTEGER NOT NULL REFERENCES crowd_type(id) ON DELETE CASCADE,
    suitability TEXT NOT NULL DEFAULT 'suitable',
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (dish_id, crowd_id)
);

-- ========== 餐序类型 ==========

CREATE TABLE meal_type (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    code TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    default_time TEXT NOT NULL,
    is_fixed INTEGER NOT NULL DEFAULT 1,
    source TEXT NOT NULL DEFAULT 'preset',
    status INTEGER NOT NULL DEFAULT 1
);

-- ========== 每餐记录 ==========

CREATE TABLE meal_record (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    date TEXT NOT NULL,
    meal_type_id INTEGER NOT NULL REFERENCES meal_type(id),
    meal_time TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_meal_record_date ON meal_record(date);
CREATE INDEX idx_meal_record_created_at ON meal_record(created_at DESC);

CREATE TABLE meal_record_dish (
    meal_record_id INTEGER NOT NULL REFERENCES meal_record(id) ON DELETE CASCADE,
    dish_id INTEGER NOT NULL REFERENCES dish(id),
    sort_order INTEGER NOT NULL DEFAULT 0,
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (meal_record_id, dish_id)
);

-- 喜爱度自动累加：MVP 在应用层 Repository 里维护（SQLDelight 当前方言不支持触发器 NEW 引用）。
-- 在 MealRecordRepository.save() 中插入 meal_record_dish 后调用 incrementDishPreference()。

-- ========== 收藏组合 ==========

CREATE TABLE favorite_combo (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'user',
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE favorite_combo_dish (
    combo_id INTEGER NOT NULL REFERENCES favorite_combo(id) ON DELETE CASCADE,
    dish_id INTEGER NOT NULL REFERENCES dish(id),
    status INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (combo_id, dish_id)
);

-- ========== 用户偏好与档案 ==========

CREATE TABLE user_preferences (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

-- [AI修改] 健康档案统一到调养病种：改为引用 food_category（dimension=crowd 的 care_ 病种），
-- 与调养 Tab / ingredient_care_rule 同一套病种，不再用旧 crowd_type（仅 4 项）。
CREATE TABLE user_health_profile (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    care_category_id INTEGER NOT NULL REFERENCES food_category(id) ON DELETE CASCADE,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE UNIQUE INDEX uq_user_health_profile ON user_health_profile(care_category_id);

-- ========== 厨房小助手 ==========

-- [AI生成] 烹饪计时模板只保存用户配置，不保存运行/暂停/响铃等临时状态。
CREATE TABLE cooking_timer_template (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    duration_seconds INTEGER NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    ringtone_uri TEXT NOT NULL DEFAULT '',
    ringtone_title TEXT NOT NULL DEFAULT '系统默认铃声',
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    status INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX idx_cooking_timer_template_sort ON cooking_timer_template(sort_order, id);

-- ========== 库存（我家食材） ==========

-- [AI生成] 库存表：从预设/自定义食材加入的家庭在手食材（我家食材）。
-- 独立表（非 ingredient 加列），以支持数量/入库时间/临期等家庭食材库信息与未来「临期提醒/按量配菜」。
CREATE TABLE pantry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ingredient_id INTEGER NOT NULL REFERENCES ingredient(id) ON DELETE CASCADE,
    quantity REAL,
    unit_id INTEGER REFERENCES measurement_unit(id),
    added_at INTEGER NOT NULL,
    expire_at INTEGER,
    note TEXT NOT NULL DEFAULT '',
    status INTEGER NOT NULL DEFAULT 1, -- 1=在手，0=已移出/用完（保留复购历史）
    serving_count INTEGER NOT NULL DEFAULT 0 -- [AI生成] 份数=可做几次菜(用户提供总量)；剩余由派生占用算，不落库
);

CREATE UNIQUE INDEX uq_pantry_ingredient ON pantry(ingredient_id);

-- ============================================================
-- 查询定义
-- ============================================================

-- ===== 元数据 / 初始化检查 =====

countCookingMethods:
SELECT COUNT(*) FROM cooking_method WHERE status = 1;

countMealTypes:
SELECT COUNT(*) FROM meal_type WHERE status = 1;

countCrowdTypes:
SELECT COUNT(*) FROM crowd_type WHERE status = 1;

countFoodCategories:
SELECT COUNT(*) FROM food_category WHERE status = 1;

countDishTags:
SELECT COUNT(*) FROM dish_tag WHERE status = 1;

countMeasurementUnits:
SELECT COUNT(*) FROM measurement_unit WHERE status = 1;

countUserPreferences:
SELECT COUNT(*) FROM user_preferences WHERE status = 1;

-- ===== cooking_timer_template =====

insertCookingTimerTemplate:
INSERT INTO cooking_timer_template(
    name,
    duration_seconds,
    note,
    ringtone_uri,
    ringtone_title,
    sort_order,
    created_at,
    updated_at,
    status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1);

selectAllCookingTimerTemplates:
SELECT *
FROM cooking_timer_template
WHERE status = 1
ORDER BY sort_order, id;

updateCookingTimerTemplate:
UPDATE cooking_timer_template
SET name = :name,
    duration_seconds = :duration_seconds,
    note = :note,
    ringtone_uri = :ringtone_uri,
    ringtone_title = :ringtone_title,
    updated_at = :updated_at
WHERE id = :id AND status = 1;

softDeleteCookingTimerTemplate:
UPDATE cooking_timer_template
SET status = 0,
    updated_at = :updated_at
WHERE id = :id AND status = 1;

-- ===== cooking_method =====

insertCookingMethod:
INSERT OR IGNORE INTO cooking_method(name, source, created_at, status) VALUES (?, ?, ?, 1);

selectAllCookingMethods:
SELECT * FROM cooking_method WHERE status = 1 ORDER BY id;

selectCookingMethodById:
SELECT * FROM cooking_method WHERE id = ? AND status = 1;

-- ===== measurement_unit =====

insertMeasurementUnit:
INSERT OR IGNORE INTO measurement_unit(name, source, status) VALUES (?, ?, 1);

selectAllMeasurementUnits:
SELECT * FROM measurement_unit WHERE status = 1 ORDER BY id;

-- ===== crowd_type =====

insertCrowdType:
INSERT OR IGNORE INTO crowd_type(name, description, source, created_at, status) VALUES (?, ?, ?, ?, 1);

selectAllCrowdTypes:
SELECT * FROM crowd_type WHERE status = 1 ORDER BY id;

selectCrowdTypeById:
SELECT * FROM crowd_type WHERE id = ? AND status = 1;

-- ===== meal_type =====

insertMealType:
INSERT OR IGNORE INTO meal_type(code, name, default_time, is_fixed, source, status) VALUES (?, ?, ?, ?, ?, 1);

selectAllMealTypes:
SELECT * FROM meal_type WHERE status = 1 ORDER BY default_time;

selectMealTypeById:
SELECT * FROM meal_type WHERE id = ? AND status = 1;

selectFixedMealTypes:
SELECT * FROM meal_type WHERE is_fixed = 1 AND status = 1 ORDER BY default_time;

-- ===== food_category =====

insertFoodCategory:
INSERT INTO food_category(name, dimension, parent_id, crowd_type_id, sort_order, icon, source, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectTopLevelCategories:
SELECT * FROM food_category WHERE parent_id IS NULL AND status = 1 ORDER BY sort_order, id;

selectChildCategories:
SELECT * FROM food_category WHERE parent_id = ? AND status = 1 ORDER BY sort_order, id;

selectCategoryById:
SELECT * FROM food_category WHERE id = ? AND status = 1;

countChildren:
SELECT COUNT(*) FROM food_category WHERE parent_id = ? AND status = 1;

-- [AI生成] 分类管理使用：读取全部有效分类，避免 UI 只看到已展开的局部分类树。
selectAllFoodCategories:
SELECT * FROM food_category
WHERE status = 1
ORDER BY parent_id IS NOT NULL, sort_order, id;

-- [AI生成] 仅用户自建的通用分类允许编辑名称/图标，预设分类和慢病分类保持只读。
updateUserFoodCategory:
UPDATE food_category
SET name = :name, icon = :icon
WHERE id = :id
  AND source = 'user'
  AND dimension = 'general'
  AND crowd_type_id IS NULL
  AND status = 1;

-- [AI生成] 分类删除采用软删除，保留操作痕迹，符合全库 status 字段约定。
softDeleteUserFoodCategory:
UPDATE food_category
SET status = 0
WHERE id = :id
  AND source = 'user'
  AND dimension = 'general'
  AND crowd_type_id IS NULL;

-- [AI生成] 用户分类被删除后，只解除分类关系，不删除食材本体。
unlinkIngredientCategoryByCategory:
UPDATE ingredient_category
SET status = 0
WHERE category_id = ?;

-- ===== ingredient =====

insertIngredient:
INSERT INTO ingredient(name, alias, pinyin, image_path, thumbnail_path, emoji, default_unit_id, source, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

selectAllIngredients:
SELECT id,
       COALESCE(name, '') AS name,
       COALESCE(alias, '') AS alias,
       COALESCE(pinyin, '') AS pinyin,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(emoji, '🥗') AS emoji,
       default_unit_id,
       COALESCE(source, 'preset') AS source,
       COALESCE(created_at, 0) AS created_at
FROM ingredient
WHERE status = 1
ORDER BY pinyin, name;

selectIngredientById:
SELECT id,
       COALESCE(name, '') AS name,
       COALESCE(alias, '') AS alias,
       COALESCE(pinyin, '') AS pinyin,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(emoji, '🥗') AS emoji,
       default_unit_id,
       COALESCE(source, 'preset') AS source,
       COALESCE(created_at, 0) AS created_at
FROM ingredient
WHERE id = ? AND status = 1;

sanitizeLegacyNullTextFields:
UPDATE ingredient
SET name = COALESCE(name, ''),
    alias = COALESCE(alias, ''),
    pinyin = COALESCE(pinyin, ''),
    image_path = COALESCE(image_path, ''),
    thumbnail_path = COALESCE(thumbnail_path, ''),
    emoji = COALESCE(emoji, '🥗'),
    source = COALESCE(source, 'preset'),
    created_at = COALESCE(created_at, 0),
    last_referenced_at = COALESCE(last_referenced_at, 0),
    status = COALESCE(status, 1);

sanitizeLegacyDishNullTextFields:
UPDATE dish
SET name = COALESCE(name, ''),
    special_note = COALESCE(special_note, ''),
    description = COALESCE(description, ''),
    image_path = COALESCE(image_path, ''),
    thumbnail_path = COALESCE(thumbnail_path, ''),
    source = COALESCE(source, 'user'),
    created_at = COALESCE(created_at, 0),
    updated_at = COALESCE(updated_at, 0),
    status = COALESCE(status, 1);

updateUserIngredient:
UPDATE ingredient
SET name = ?, alias = ?, image_path = ?, thumbnail_path = ?, default_unit_id = ?
WHERE id = ? AND status = 1;

updateIngredientEmoji:
UPDATE ingredient
SET emoji = ?
WHERE id = ? AND status = 1;

-- [AI生成] 食材被菜品引用时更新时间戳，用于“最近使用”虚拟分类。
updateIngredientLastReferencedAt:
UPDATE ingredient
SET last_referenced_at = :last_referenced_at
WHERE id = :id AND status = 1;

-- [AI修改] 软删除自定义食材：置失效并记录失效原因；被菜品引用时仍在菜品里灰显保留。
deleteUserIngredient:
UPDATE ingredient
SET status = 0, reason = :reason
WHERE id = :id AND source = 'user';

-- [AI生成] 恢复失效的自定义食材：清空失效原因、置回有效。
restoreUserIngredient:
UPDATE ingredient
SET status = 1, reason = ''
WHERE id = ? AND source = 'user';

-- [AI生成] 彻底删除自定义食材（回收站硬删）：仅限用户自建；被引用的 dish_ingredient 关系随外键级联删除。
hardDeleteUserIngredient:
DELETE FROM ingredient
WHERE id = ? AND source = 'user';

-- [AI生成] 回收站：列出失效的自定义食材，供恢复/彻底删除。
selectInactiveUserIngredients:
SELECT id,
       COALESCE(name, '') AS name,
       COALESCE(alias, '') AS alias,
       COALESCE(pinyin, '') AS pinyin,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(emoji, '🥗') AS emoji,
       default_unit_id,
       COALESCE(source, 'user') AS source,
       COALESCE(created_at, 0) AS created_at,
       COALESCE(reason, '') AS reason
FROM ingredient
WHERE status = 0 AND source = 'user'
ORDER BY name COLLATE NOCASE ASC;

-- [AI生成] 预设食材的有效/失效完全跟随后台数据包：seed 导入时同步 status 与失效原因。
updatePresetIngredientStatus:
UPDATE ingredient
SET status = :status, reason = :reason
WHERE id = :id AND source = 'preset';

searchIngredients:
SELECT id,
       COALESCE(name, '') AS name,
       COALESCE(alias, '') AS alias,
       COALESCE(pinyin, '') AS pinyin,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(emoji, '🥗') AS emoji,
       default_unit_id,
       COALESCE(source, 'preset') AS source,
       COALESCE(created_at, 0) AS created_at
FROM ingredient
WHERE status = 1 AND (name LIKE :kw OR alias LIKE :kw OR pinyin LIKE :kw)
ORDER BY pinyin, name;

selectIngredientsByCategory:
SELECT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at
FROM ingredient i
JOIN ingredient_category ic ON i.id = ic.ingredient_id
WHERE ic.category_id = ? AND i.status = 1 AND ic.status = 1
ORDER BY i.pinyin, i.name;

-- [AI修改] “最近使用”虚拟分类：只要食材被保存进菜品就计入，按最后被菜品引用时间倒序展示。
selectRecentlyUsedIngredients:
SELECT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at
FROM ingredient i
WHERE i.status = 1
  AND i.last_referenced_at > 0
ORDER BY i.last_referenced_at DESC, i.name;

selectIngredientsByCrowd:
SELECT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at,
       COALESCE(ci.advice_level, 'neutral') AS advice_level,
       COALESCE(ci.reason, '') AS reason
FROM ingredient i
JOIN crowd_ingredient ci ON i.id = ci.ingredient_id
WHERE ci.crowd_id = ? AND i.status = 1 AND ci.status = 1
ORDER BY
  CASE ci.advice_level WHEN 'recommend' THEN 1 WHEN 'limit' THEN 2 WHEN 'avoid' THEN 3 ELSE 4 END,
  i.pinyin, i.name;

upsertCrowdIngredient:
INSERT OR REPLACE INTO crowd_ingredient(crowd_id, ingredient_id, advice_level, reason, daily_limit, source, status)
VALUES (?, ?, ?, ?, ?, ?, 1);

linkIngredientCategory:
INSERT OR REPLACE INTO ingredient_category(ingredient_id, category_id, status) VALUES (?, ?, 1);

unlinkIngredientCategoriesByIngredient:
UPDATE ingredient_category
SET status = 0
WHERE ingredient_id = ?;

selectCategoryIdsByIngredient:
SELECT category_id
FROM ingredient_category
WHERE ingredient_id = ? AND status = 1
ORDER BY category_id;

selectCategoriesByIngredient:
SELECT fc.*
FROM food_category fc
JOIN ingredient_category ic ON fc.id = ic.category_id
WHERE ic.ingredient_id = ? AND ic.status = 1 AND fc.status = 1
ORDER BY fc.dimension, fc.sort_order, fc.id;

selectIngredientsByCategoryIds:
SELECT DISTINCT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at
FROM ingredient i
JOIN ingredient_category ic ON i.id = ic.ingredient_id
WHERE ic.category_id IN ?
  AND i.status = 1
  AND ic.status = 1
ORDER BY i.pinyin, i.name;

-- [AI生成] 全部有效食材 id（AI"随机推荐"从整个食材库取，而非仅库存）。
selectAllIngredientIds:
SELECT id FROM ingredient WHERE status = 1;

-- [AI生成] 各食材的营养维度/应季分类（周期规划做营养均衡与应季优先）。
selectNutritionSeasonTags:
SELECT ic.ingredient_id, fc.name AS tag_name, fc.dimension AS dim
FROM ingredient_category ic
JOIN food_category fc ON fc.id = ic.category_id
WHERE ic.status = 1 AND fc.status = 1 AND fc.dimension IN ('nutrition', 'season');

-- [AI生成] 调料/油脂类食材 id（AI 推荐"可做性=非调料齐"用；调料默认常备）。
-- 按稳定根类名「调味品」「油脂类」及其子类识别，不依赖分类 id。
selectSeasoningIngredientIds:
SELECT DISTINCT ic.ingredient_id
FROM ingredient_category ic
JOIN food_category fc ON fc.id = ic.category_id
WHERE ic.status = 1 AND fc.status = 1
  AND (
    fc.name IN ('调味品', '油脂类')
    OR fc.parent_id IN (SELECT id FROM food_category WHERE name IN ('调味品', '油脂类') AND status = 1)
  );

-- [AI生成] 最近吃过的菜 id（按最近食用日期倒序，去重限量）；AI 推荐去重降权用。
selectRecentEatenDishIds:
SELECT mrd.dish_id
FROM meal_record_dish mrd
JOIN meal_record mr ON mr.id = mrd.meal_record_id
WHERE mr.status = 1 AND mrd.status = 1
GROUP BY mrd.dish_id
ORDER BY MAX(mr.date) DESC
LIMIT ?;

-- [AI生成] 调养 tab 按病种分类通过调养规则聚合食材；剂量语义由 advice_level 表达，红绿灯分组在应用层完成。
selectIngredientsByCareCategories:
SELECT DISTINCT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at,
       r.advice_level,
       COALESCE(r.reason, '') AS reason
FROM ingredient i
JOIN ingredient_care_rule r ON r.ingredient_id = i.id
WHERE r.category_id IN ?
  AND i.status = 1
  AND r.status = 1
ORDER BY CASE r.advice_level WHEN 'recommend' THEN 0 WHEN 'limit' THEN 1 ELSE 2 END, i.pinyin, i.name;

upsertIngredientDetail:
INSERT OR REPLACE INTO ingredient_detail(
    ingredient_id,
    common_methods,
    prep_tips,
    eating_notes,
    storage_tips,
    health_note,
    updated_at,
    status
) VALUES (?, ?, ?, ?, ?, ?, ?, 1);

selectIngredientDetail:
SELECT ingredient_id,
       common_methods,
       prep_tips,
       eating_notes,
       storage_tips,
       health_note,
       updated_at
FROM ingredient_detail
WHERE ingredient_id = ? AND status = 1;

clearIngredientCareRules:
UPDATE ingredient_care_rule
SET status = 0
WHERE ingredient_id = ?;

upsertIngredientCareRule:
INSERT OR REPLACE INTO ingredient_care_rule(ingredient_id, category_id, advice_level, reason, source, status)
VALUES (?, ?, ?, ?, ?, 1);

selectCareRulesByIngredient:
SELECT cr.id,
       cr.ingredient_id,
       cr.category_id,
       fc.name AS category_name,
       cr.advice_level,
       cr.reason,
       cr.source
FROM ingredient_care_rule cr
JOIN food_category fc ON cr.category_id = fc.id
WHERE cr.ingredient_id = ? AND cr.status = 1 AND fc.status = 1
ORDER BY fc.sort_order, fc.id;

-- ===== dish =====

insertDish:
INSERT INTO dish(name, cooking_method_id, preference, special_note, description, image_path, thumbnail_path, source, created_at, updated_at)
VALUES (?, ?, 0, ?, ?, ?, ?, ?, ?, ?);

-- [AI生成] 预设菜补齐式 seed 用：按名判断预设菜是否已存在，避免重复插入。
selectPresetDishIdByName:
SELECT id FROM dish WHERE name = ? AND source = 'preset' AND status = 1 LIMIT 1;

updateDish:
UPDATE dish
SET name = ?, cooking_method_id = ?, special_note = ?, description = ?, image_path = ?, thumbnail_path = ?, updated_at = ?
WHERE id = ?;

deleteDish:
UPDATE dish SET status = 0 WHERE id = ?;

selectAllDishes:
SELECT * FROM dish WHERE status = 1 ORDER BY updated_at DESC;

selectDishById:
SELECT * FROM dish WHERE id = ? AND status = 1;

-- [AI生成] 编辑/详情页专用安全读取：旧库可能残留 NULL 文本字段，统一兜底为空字符串，避免表单加载被 SQLDelight 非空映射中断。
selectDishForEditById:
SELECT id,
       COALESCE(name, '') AS name,
       cooking_method_id,
       COALESCE(preference, 0) AS preference,
       COALESCE(special_note, '') AS special_note,
       COALESCE(description, '') AS description,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(source, 'user') AS source,
       COALESCE(created_at, 0) AS created_at,
       COALESCE(updated_at, 0) AS updated_at
FROM dish
WHERE id = ? AND status = 1;

selectDishesByPopularity:
SELECT * FROM dish WHERE status = 1 ORDER BY preference DESC, name COLLATE NOCASE ASC LIMIT ?;

selectDishesByRecent:
SELECT DISTINCT d.* FROM dish d
JOIN meal_record_dish mrd ON d.id = mrd.dish_id
JOIN meal_record mr ON mrd.meal_record_id = mr.id
WHERE d.status = 1 AND mrd.status = 1 AND mr.status = 1
ORDER BY mr.created_at DESC
LIMIT ?;

selectDishesByPreference:
SELECT * FROM dish WHERE status = 1 ORDER BY preference DESC, updated_at DESC;

selectDishesByPinyin:
SELECT * FROM dish WHERE status = 1 ORDER BY name COLLATE NOCASE ASC;

searchDishes:
SELECT DISTINCT d.* FROM dish d
LEFT JOIN dish_tag_rel dtr ON d.id = dtr.dish_id
LEFT JOIN dish_tag dt ON dtr.tag_id = dt.id
LEFT JOIN dish_ingredient di ON d.id = di.dish_id
LEFT JOIN ingredient i ON di.ingredient_id = i.id
WHERE d.status = 1
  AND (d.name LIKE :kw
   OR (dtr.status = 1 AND dt.status = 1 AND dt.name LIKE :kw)
   OR (di.status = 1 AND i.status = 1 AND i.name LIKE :kw)
   OR (di.status = 1 AND i.status = 1 AND i.alias LIKE :kw))
ORDER BY d.preference DESC, d.name COLLATE NOCASE ASC;

selectDishesByIngredientMatch:
SELECT d.id,
       d.name,
       d.image_path,
       d.thumbnail_path,
       d.preference,
       d.cooking_method_id,
       d.source,
       COUNT(DISTINCT CASE WHEN di.ingredient_id IN :ingredientIds THEN di.ingredient_id END) AS match_count,
       COUNT(DISTINCT di.ingredient_id) AS total_count
FROM dish d
JOIN dish_ingredient di ON d.id = di.dish_id
WHERE d.status = 1
  AND di.status = 1
GROUP BY d.id
HAVING match_count > 0
ORDER BY match_count DESC, total_count ASC, d.preference DESC, d.name COLLATE NOCASE ASC
LIMIT :limit;

-- ===== dish_tag / dish_tag_rel =====

insertDishTag:
INSERT OR IGNORE INTO dish_tag(name, source, created_at, status) VALUES (?, ?, ?, 1);

selectAllDishTags:
SELECT * FROM dish_tag WHERE status = 1 ORDER BY name COLLATE NOCASE ASC;

selectDishTagByName:
SELECT * FROM dish_tag WHERE name = ? AND status = 1;

selectTagsByDish:
SELECT dt.* FROM dish_tag dt
JOIN dish_tag_rel dtr ON dt.id = dtr.tag_id
WHERE dtr.dish_id = ? AND dtr.status = 1 AND dt.status = 1
ORDER BY dt.name;

-- [AI修改] 批量读取菜品标签，避免列表和食历组装时对每个菜品单独查询。
selectTagsByDishIds:
SELECT dtr.dish_id, dt.name
FROM dish_tag_rel dtr
JOIN dish_tag dt ON dtr.tag_id = dt.id
WHERE dtr.dish_id IN ? AND dtr.status = 1 AND dt.status = 1
ORDER BY dtr.dish_id, dt.name;

-- [AI生成] 批量读取菜品烹饪方式，支持菜品列表和详情展示多个方式。
selectCookingMethodsByDishIds:
SELECT dcmr.dish_id, cm.id, cm.name
FROM dish_cooking_method_rel dcmr
JOIN cooking_method cm ON dcmr.cooking_method_id = cm.id
WHERE dcmr.dish_id IN ? AND dcmr.status = 1 AND cm.status = 1
ORDER BY dcmr.dish_id, cm.name;

selectCookingMethodsByDish:
SELECT cm.*
FROM cooking_method cm
JOIN dish_cooking_method_rel dcmr ON cm.id = dcmr.cooking_method_id
WHERE dcmr.dish_id = ? AND dcmr.status = 1 AND cm.status = 1
ORDER BY cm.name;

linkDishCookingMethod:
INSERT OR REPLACE INTO dish_cooking_method_rel(dish_id, cooking_method_id, status) VALUES (?, ?, 1);

unlinkCookingMethodsOfDish:
UPDATE dish_cooking_method_rel SET status = 0 WHERE dish_id = ?;

linkDishTag:
INSERT OR REPLACE INTO dish_tag_rel(dish_id, tag_id, status) VALUES (?, ?, 1);

unlinkAllTagsOfDish:
UPDATE dish_tag_rel SET status = 0 WHERE dish_id = ?;

-- ===== dish_ingredient =====

insertDishIngredient:
INSERT OR REPLACE INTO dish_ingredient(dish_id, ingredient_id, quantity, unit_id, is_main, status)
VALUES (?, ?, ?, ?, ?, 1);

-- [AI修改] 去掉 i.status=1 过滤：菜品要保留对失效食材的引用（灰显 + 失效原因），
-- 只按 di.status=1 判断该引用本身是否有效。同时读出食材 status/reason 供 UI 判断灰显。
selectIngredientsOfDish:
SELECT di.id AS rel_id, di.dish_id, di.ingredient_id, di.quantity, di.unit_id, di.is_main,
       COALESCE(i.name, '') AS ingredient_name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.status, 1) AS ingredient_status,
       COALESCE(i.reason, '') AS ingredient_reason,
       COALESCE(u.name, '') AS unit_name
FROM dish_ingredient di
JOIN ingredient i ON di.ingredient_id = i.id
LEFT JOIN measurement_unit u ON di.unit_id = u.id
WHERE di.dish_id = ? AND di.status = 1
ORDER BY di.is_main DESC, di.id ASC;

deleteIngredientsOfDish:
UPDATE dish_ingredient SET status = 0 WHERE dish_id = ?;

deleteDishIngredientsByIngredient:
UPDATE dish_ingredient SET status = 0 WHERE ingredient_id = ?;

-- [AI生成] 彻底删除食材时物理清除其菜品关联行（ingredient_id 无 ON DELETE CASCADE，需显式删除避免外键悬挂）。
hardDeleteDishIngredientsByIngredient:
DELETE FROM dish_ingredient WHERE ingredient_id = ?;

-- ===== dish_step =====

insertDishStep:
INSERT INTO dish_step(dish_id, sort_order, text, image_path, thumbnail_path, created_at, updated_at, status)
VALUES (?, ?, ?, ?, ?, ?, ?, 1);

selectStepsOfDish:
SELECT id,
       dish_id,
       sort_order,
       COALESCE(text, '') AS text,
       COALESCE(image_path, '') AS image_path,
       COALESCE(thumbnail_path, '') AS thumbnail_path,
       COALESCE(created_at, 0) AS created_at,
       COALESCE(updated_at, 0) AS updated_at
FROM dish_step
WHERE dish_id = ? AND status = 1
ORDER BY sort_order ASC, id ASC;

deleteStepsOfDish:
UPDATE dish_step SET status = 0, updated_at = ? WHERE dish_id = ?;

selectIngredientIdByNameIncludingInactive:
SELECT id, status
FROM ingredient
WHERE name = ?
LIMIT 1;

restorePresetIngredient:
UPDATE ingredient
SET alias = ?, pinyin = ?, emoji = ?, default_unit_id = ?, source = 'preset', status = 1
WHERE id = ?;

-- ===== meal_record =====

insertMealRecord:
INSERT INTO meal_record(date, meal_type_id, meal_time, note, created_at)
VALUES (?, ?, ?, ?, ?);

selectMealRecordsByDate:
SELECT * FROM meal_record WHERE date = ? AND status = 1 ORDER BY meal_time;

-- [AI修改] 食历只展示真实存在餐食记录的日期，按时间正序分页。
selectTimelineDatesAsc:
SELECT DISTINCT date FROM meal_record
WHERE status = 1
ORDER BY date ASC;

-- [AI修改] 按一组日期批量读取 meal_record，避免食历分页后逐日查询。
selectMealRecordsByDates:
SELECT * FROM meal_record
WHERE date IN ?
  AND status = 1
ORDER BY date ASC, meal_time ASC;

selectMealRecordById:
SELECT * FROM meal_record WHERE id = ? AND status = 1;

selectMealRecordsByDateRange:
SELECT * FROM meal_record
WHERE date BETWEEN :start AND :end AND status = 1
ORDER BY date DESC, meal_time;

selectMealRecordsBetween:
SELECT * FROM meal_record
WHERE date >= :start AND date <= :end AND status = 1
ORDER BY date DESC, meal_time;

selectFutureMealRecords:
SELECT * FROM meal_record
WHERE date > :today AND status = 1
ORDER BY date ASC, meal_time ASC
LIMIT ?;

-- [AI生成] 首页计划只展示真实存在且日期不早于今天的 meal_record，不再为空的今天生成占位卡片。
selectUpcomingMealRecords:
SELECT * FROM meal_record
WHERE date >= :today AND status = 1
ORDER BY date ASC, meal_time ASC
LIMIT ?;

selectDistinctDates:
SELECT DISTINCT date FROM meal_record
WHERE status = 1
ORDER BY date DESC
LIMIT :limit OFFSET :offset;

-- [AI修改] 全局搜索餐食：命中日期或关联菜品名后返回对应日期，UI 再按日期组装整天餐食卡片。
searchMealDates:
SELECT DISTINCT mr.date
FROM meal_record mr
LEFT JOIN meal_record_dish mrd ON mr.id = mrd.meal_record_id
LEFT JOIN dish d ON mrd.dish_id = d.id
WHERE mr.status = 1
  AND (mr.date LIKE :kw OR (mrd.status = 1 AND d.status = 1 AND d.name LIKE :kw))
ORDER BY mr.date DESC
LIMIT :limit OFFSET :offset;

selectMinAndMaxDate:
SELECT MIN(date) AS min_date, MAX(date) AS max_date FROM meal_record WHERE status = 1;

deleteMealRecord:
UPDATE meal_record SET status = 0 WHERE id = ?;

deleteMealRecordsByDate:
UPDATE meal_record SET status = 0 WHERE date = ?;

-- ===== meal_record_dish =====

deleteMealRecordDishesByDate:
UPDATE meal_record_dish
SET status = 0
WHERE meal_record_id IN (SELECT id FROM meal_record WHERE date = ?);

insertMealRecordDish:
INSERT OR REPLACE INTO meal_record_dish(meal_record_id, dish_id, sort_order, status)
VALUES (?, ?, ?, 1);

incrementDishPreference:
UPDATE dish
   SET preference = MIN(preference + 1, 1000),
       updated_at = ?
 WHERE id = ?;

selectDishesOfMealRecord:
SELECT d.*, mrd.sort_order FROM dish d
JOIN meal_record_dish mrd ON d.id = mrd.dish_id
WHERE mrd.meal_record_id = ? AND mrd.status = 1 AND d.status = 1
ORDER BY mrd.sort_order, d.name;

-- [AI修改] 批量读取多条餐食记录下的菜品，减少首页计划和食历窗口的 N+1 查询。
-- [AI修改] 去掉 d.status=1：菜品软删后历史餐食仍要显示当时吃的菜(与食材保留引用一致)；
-- 菜品库列表另用带 status=1 的查询，软删菜不进库、只留在历史。
selectDishesOfMealRecords:
SELECT mrd.meal_record_id, d.*, mrd.sort_order FROM dish d
JOIN meal_record_dish mrd ON d.id = mrd.dish_id
WHERE mrd.meal_record_id IN ? AND mrd.status = 1
ORDER BY mrd.meal_record_id, mrd.sort_order, d.name;

selectDishIdsByMealDate:
SELECT DISTINCT mrd.dish_id
FROM meal_record_dish mrd
JOIN meal_record mr ON mrd.meal_record_id = mr.id
WHERE mr.date = ? AND mr.status = 1 AND mrd.status = 1;

-- [AI生成] 删除菜品前检查该菜品被哪些日期/餐次引用，用于给用户明确风险提示。
selectMealReferencesByDish:
SELECT mr.date,
       mt.name AS meal_name,
       mr.meal_time
FROM meal_record_dish mrd
JOIN meal_record mr ON mrd.meal_record_id = mr.id
JOIN meal_type mt ON mr.meal_type_id = mt.id
WHERE mrd.dish_id = ? AND mrd.status = 1 AND mr.status = 1 AND mt.status = 1
ORDER BY mr.date DESC, mr.meal_time ASC;

deleteMealRecordDishes:
UPDATE meal_record_dish SET status = 0 WHERE meal_record_id = ?;

removeDishFromMealRecord:
UPDATE meal_record_dish SET status = 0 WHERE meal_record_id = ? AND dish_id = ?;

-- ===== favorite_combo =====

insertFavoriteCombo:
INSERT INTO favorite_combo(name, source, created_at) VALUES (?, ?, ?);

selectAllCombos:
SELECT * FROM favorite_combo WHERE status = 1 ORDER BY created_at DESC;

deleteCombo:
UPDATE favorite_combo SET status = 0 WHERE id = ?;

linkComboDish:
INSERT OR REPLACE INTO favorite_combo_dish(combo_id, dish_id, status) VALUES (?, ?, 1);

deleteFavoriteComboDishesByDish:
UPDATE favorite_combo_dish SET status = 0 WHERE dish_id = ?;

selectDishesOfCombo:
SELECT d.* FROM dish d
JOIN favorite_combo_dish fcd ON d.id = fcd.dish_id
WHERE fcd.combo_id = ? AND fcd.status = 1 AND d.status = 1
ORDER BY d.name;

-- ===== user_preferences =====

upsertPreference:
INSERT OR REPLACE INTO user_preferences(key, value, updated_at, status) VALUES (?, ?, ?, 1);

selectPreference:
SELECT * FROM user_preferences WHERE key = ? AND status = 1;

selectAllPreferences:
SELECT * FROM user_preferences WHERE status = 1;

-- ===== user_health_profile =====

insertHealthProfile:
INSERT OR REPLACE INTO user_health_profile(care_category_id, enabled, created_at, status) VALUES (?, 1, ?, 1);

updateHealthProfileEnabled:
UPDATE user_health_profile SET enabled = ?, status = 1 WHERE care_category_id = ?;

-- [AI修改] 健康档案病种改从 food_category（调养病种）JOIN；food_category 无描述，描述列返回空串占位。
selectEnabledHealthProfiles:
SELECT hp.*, fc.name AS crowd_name, '' AS crowd_description
FROM user_health_profile hp
JOIN food_category fc ON hp.care_category_id = fc.id
WHERE hp.enabled = 1 AND hp.status = 1 AND fc.status = 1
ORDER BY fc.sort_order, hp.created_at;

selectAllHealthProfiles:
SELECT hp.*, fc.name AS crowd_name, '' AS crowd_description
FROM user_health_profile hp
JOIN food_category fc ON hp.care_category_id = fc.id
WHERE hp.status = 1 AND fc.status = 1
ORDER BY fc.sort_order, hp.created_at;

deleteHealthProfile:
UPDATE user_health_profile SET status = 0 WHERE care_category_id = ?;

-- [AI生成] 健康档案可选病种 = 调养维度（dimension=crowd）下的具体病种；排除聚合根「人群分类」，
-- 且排除旧 crowd_type 生成的 crowd_${id} 分类（那些 crowd_type_id 非空）。
selectCareCategories:
SELECT id, name, sort_order
FROM food_category
WHERE dimension = 'crowd' AND parent_id IS NOT NULL AND crowd_type_id IS NULL AND status = 1
ORDER BY sort_order, id;

-- ===== pantry 库存（我家食材） =====

-- [AI生成] 加入/更新库存：ingredient_id 唯一，冲突时整行替换（重新加入=刷新为在手）。
-- 用 INSERT OR REPLACE 而非 ON CONFLICT DO UPDATE，兼容 Android 低版本 SQLite。
upsertPantryItem:
INSERT OR REPLACE INTO pantry(ingredient_id, quantity, unit_id, added_at, expire_at, note, status)
VALUES (:ingredient_id, :quantity, :unit_id, :added_at, :expire_at, :note, 1);

-- [AI生成] 加份数第一步：无则建(份数0, 在手)；有则忽略。SQLite3.18无UPSERT, 故两步(事务内)。
insertPantryIfAbsent:
INSERT OR IGNORE INTO pantry(ingredient_id, added_at, status, serving_count)
VALUES (:ingredient_id, :added_at, 1, 0);

-- [AI生成] 加份数第二步：结算为「当前剩余+新加」的绝对份数, 重置入库时间(窗口), 置在手。
-- 避免为0后重加把已消耗的重复计入(份数=当前剩余+delta, 而非旧份数累加)。
activatePantry:
UPDATE pantry SET serving_count = :serving_count, added_at = :added_at, status = 1
WHERE ingredient_id = :ingredient_id;

-- [AI生成] 显式设置份数(编辑/减少)。
setPantryServings:
UPDATE pantry SET serving_count = :serving_count WHERE ingredient_id = :ingredient_id;

-- [AI生成] 在手食材的份数映射(ingredient_id -> serving_count)，供派生占用与库存展示。
selectPantryServings:
SELECT ingredient_id, serving_count FROM pantry WHERE status = 1;

-- [AI生成] 在手食材份数 + 入库时间(added_at)，供"入库日起窗口"计算(入库日之前的餐不占用)。
selectPantryStock:
SELECT ingredient_id, serving_count, added_at FROM pantry WHERE status = 1;

-- [AI生成] 派生占用：所有餐食(含计划)里用到「在手食材」的菜，按时间顺序排队，供份数分配判不足。
selectPantryUsageChrono:
SELECT di.ingredient_id AS ingredient_id,
       COALESCE(i.name, '') AS ingredient_name,
       mrd.meal_record_id AS meal_record_id,
       mrd.dish_id AS dish_id,
       mr.date AS meal_date
FROM meal_record_dish mrd
JOIN meal_record mr ON mrd.meal_record_id = mr.id AND mr.status = 1
JOIN dish_ingredient di ON di.dish_id = mrd.dish_id AND di.status = 1
JOIN pantry p ON p.ingredient_id = di.ingredient_id AND p.status = 1
JOIN ingredient i ON i.id = di.ingredient_id
WHERE mrd.status = 1
ORDER BY di.ingredient_id, mr.date, mr.meal_time, mr.created_at, mrd.sort_order;

-- [AI生成] 今天及未来餐食里每道菜的主料使用(含食材名)，供餐卡"采购"判定(主料不在库→采购)。
selectMainIngredientUsageFromDate:
SELECT mrd.meal_record_id AS meal_record_id,
       mrd.dish_id AS dish_id,
       di.ingredient_id AS ingredient_id,
       COALESCE(i.name, '') AS ingredient_name,
       mr.date AS meal_date
FROM meal_record_dish mrd
JOIN meal_record mr ON mrd.meal_record_id = mr.id AND mr.status = 1
JOIN dish_ingredient di ON di.dish_id = mrd.dish_id AND di.status = 1 AND di.is_main = 1
JOIN ingredient i ON i.id = di.ingredient_id
WHERE mrd.status = 1 AND mr.date >= :today;


-- [AI生成] 库存 Tab：JOIN 出在手食材，列与 selectAllIngredients 对齐以复用 mapIngredientRow。
selectPantryIngredients:
SELECT i.id,
       COALESCE(i.name, '') AS name,
       COALESCE(i.alias, '') AS alias,
       COALESCE(i.pinyin, '') AS pinyin,
       COALESCE(i.image_path, '') AS image_path,
       COALESCE(i.thumbnail_path, '') AS thumbnail_path,
       COALESCE(i.emoji, '🥗') AS emoji,
       i.default_unit_id,
       COALESCE(i.source, 'preset') AS source,
       COALESCE(i.created_at, 0) AS created_at
FROM pantry p
JOIN ingredient i ON p.ingredient_id = i.id
WHERE p.status = 1 AND i.status = 1
ORDER BY p.added_at DESC, i.pinyin;

-- [AI生成] 在手食材 id 集合：用于详情/做法区标记「家里有」。
selectPantryIngredientIds:
SELECT ingredient_id FROM pantry WHERE status = 1;

removeFromPantry:
UPDATE pantry SET status = 0, serving_count = 0 WHERE ingredient_id = :ingredient_id;

countPantry:
SELECT COUNT(*) FROM pantry WHERE status = 1;
