<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- [AI生成] 双设备同传扫码 + 拍照均用相机；声明后拍照(ACTION_IMAGE_CAPTURE)也需运行时授予 CAMERA。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- [AI修改] P0 存储合规：数据改存 app 专属目录(getExternalFilesDir)，无需任何外部存储权限；已移除 MANAGE_EXTERNAL_STORAGE / WRITE / READ。 -->
    <!-- [AI生成] 烹饪计时到点提醒：精确闹钟(息屏/Doze也准时) + 通知 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- [AI生成] AI 快捷输入记餐语音转文字：录音仅本地识别，不上传语音文件 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- [AI生成] AI 云端推荐需要联网调用 GLM API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CookbookApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- [AI生成] 烹饪计时到点/停止广播接收器（系统级响铃，不导出） -->
        <receiver
            android:name=".kitchen.TimerAlarmReceiver"
            android:exported="false" />
        <!-- [AI生成] 计时进行中常驻前台服务（保活 + 常驻通知） -->
        <service
            android:name=".kitchen.CookingTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cooking_timer" />
        </service>
        <!-- [AI生成] 到点全屏提醒（锁屏显示、点亮屏幕、可停止） -->
        <activity
            android:name=".kitchen.TimerAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/AppTheme" />
        <!-- [AI生成] 崩溃兜底友好界面：独立 :crash 进程(原进程已崩)，全局未捕获异常时拉起替代系统闪退，可上报。 -->
        <activity
            android:name=".ui.crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />
        <!-- [AI生成] 双设备同传扫码页：固定竖屏，避免 zxing 默认横屏。 -->
        <activity
            android:name=".ui.sync.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/AppTheme" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest> 
