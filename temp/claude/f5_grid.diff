+                            ) // 没记=空心描边
+                            else -> {
+                                Box(Modifier.fillMaxSize().clip(RoundedCornerShape(4.dp)).background(nutritionLevelColor(cell.coerceAtLeast(1))))
+                                if (period == ReportPeriod.MONTH) {
+                                    Text("${levelsIdx + 1}", style = MaterialTheme.typography.labelSmall, color = Color.Black.copy(alpha = 0.55f))
+                                }
+                            }
+                        }
+                    }
+                }
+            }
         }
