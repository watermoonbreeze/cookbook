+@Composable
+private fun StructureCalendarGrid(levels: List<Int>, period: ReportPeriod, rangeStart: kotlinx.datetime.LocalDate) {
+    val leadingBlanks = if (period == ReportPeriod.MONTH) rangeStart.dayOfWeek.ordinal else 0 // 周一=0…周日=6
+    val cells = List(leadingBlanks) { -2 } + levels // -2=占位空格·-1=没记·0..4=有记级别
+    val tail = (7 - cells.size % 7) % 7
+    val rows = (cells + List(tail) { -2 }).chunked(7)
+    val weekdays = listOf("一", "二", "三", "四", "五", "六", "日")
+    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            weekdays.forEach { wd ->
+                Text(wd, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant, textAlign = TextAlign.Center, modifier = Modifier.weight(1f))
+            }
+        }
+        rows.forEachIndexed { rIdx, row ->
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                row.forEachIndexed { cIdx, cell ->
+                    val levelsIdx = rIdx * 7 + cIdx - leadingBlanks // 该格在 levels 中的下标(月:日号-1)
+                    Box(Modifier.weight(1f).aspectRatio(1f), contentAlignment = Alignment.Center) {
+                        when {
+                            cell == -2 -> Unit // 占位空格(对齐周几·透明不可点)
